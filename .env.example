# ============================================================
# FinPilot AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
APP_NAME="FinPilot AI"
APP_VERSION="1.0.0"
APP_ENV="development"                # development | staging | production
APP_DEBUG=true
SECRET_KEY="CHANGE_ME_TO_A_SECURE_64_CHAR_RANDOM_STRING"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:80"

# ----------------------------------------------------------
# Database (PostgreSQL)
# ----------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=finpilot
POSTGRES_USER=finpilot
POSTGRES_PASSWORD=finpilot_secret
DATABASE_URL=postgresql+asyncpg://finpilot:finpilot_secret@postgres:5432/finpilot

# ----------------------------------------------------------
# Redis
# ----------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@redis:6379/0
REDIS_DB=0

# ----------------------------------------------------------
# ChromaDB
# ----------------------------------------------------------
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_AUTH_TOKEN=chroma_secret_token
CHROMA_COLLECTION_NAME=finpilot_documents

# ----------------------------------------------------------
# JWT Authentication
# ----------------------------------------------------------
JWT_SECRET_KEY="CHANGE_ME_JWT_SECRET_64_CHARS_MIN"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ----------------------------------------------------------
# AI Models - Primary: Gemini 2.5 Flash
# ----------------------------------------------------------
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.1

# ----------------------------------------------------------
# AI Models - Secondary: Groq (Llama)
# ----------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=4096

# ----------------------------------------------------------
# AI Models - Fallback: OpenRouter
# ----------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3-haiku
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ----------------------------------------------------------
# Active Model Configuration
# ----------------------------------------------------------
PRIMARY_LLM_PROVIDER=gemini              # gemini | groq | openrouter
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSION=768

# ----------------------------------------------------------
# Celery
# ----------------------------------------------------------
CELERY_BROKER_URL=redis://:redis_secret@redis:6379/1
CELERY_RESULT_BACKEND=redis://:redis_secret@redis:6379/2
CELERY_MAX_RETRIES=3
CELERY_TASK_TIMEOUT=300

# ----------------------------------------------------------
# File Storage
# ----------------------------------------------------------
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,pptx,xlsx,csv,txt,png,jpg,jpeg,tiff

# ----------------------------------------------------------
# Document Processing
# ----------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CHUNKS_PER_DOCUMENT=500
OCR_ENABLED=true
TABLE_EXTRACTION_ENABLED=true

# ----------------------------------------------------------
# Email (for report delivery)
# ----------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM="FinPilot AI <noreply@finpilot.ai>"
SMTP_TLS=true

# ----------------------------------------------------------
# OAuth 2.0 (Google)
# ----------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ----------------------------------------------------------
# Logging
# ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=/app/logs
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=10

# ----------------------------------------------------------
# Rate Limiting
# ----------------------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ----------------------------------------------------------
# Demo Mode (runs without live API keys using mock responses)
# ----------------------------------------------------------
DEMO_MODE=false
DEMO_USER_EMAIL=demo@finpilot.ai
DEMO_USER_PASSWORD=Demo@FinPilot2024

# ----------------------------------------------------------
# Frontend (Vite)
# ----------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_APP_NAME="FinPilot AI"
VITE_APP_VERSION="1.0.0"
VITE_DEMO_MODE=false
VITE_GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
